#!/usr/bin/env bash
# HarpreetLinux post-install setup: pick tool groups, then install them from the internet.
set -u
GROUP_DIR=/usr/share/harpreetlinux/groups
items=()
for f in "$GROUP_DIR"/*.list; do
  name="$(basename "$f" .list)"
  desc="$(head -n1 "$f" | sed 's/^# *//')"
  items+=(FALSE "$name" "$desc")
done
choice=$(zenity --list --checklist --separator='|' --title="HarpreetLinux Setup" \
  --text="Choose tool groups to install. Internet is needed." \
  --column=Install --column=Group --column=Description --width=760 --height=460 "${items[@]}") || exit 0
IFS='|' read -ra selected <<< "$choice"
pkgs=()
for g in "${selected[@]}"; do
  while read -r p; do [[ -z "$p" || "$p" == \#* ]] || pkgs+=("$p"); done < "$GROUP_DIR/$g.list"
done
sudo apt-get update
failed=()
for p in "${pkgs[@]}"; do
  if sudo apt-get install -y --no-install-recommends "$p"; then echo "OK: $p"; else echo "SKIPPED: $p"; failed+=("$p"); fi
done
echo; echo "Done. Skipped packages: ${failed[*]:-none}"
read -r -p "Press Enter to close."
