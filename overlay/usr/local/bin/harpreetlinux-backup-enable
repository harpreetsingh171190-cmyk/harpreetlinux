#!/bin/sh
# Root helper: writes the Timeshift settings for this installed system and turns on schedules.
# Exit codes: 0 done, 1 error, 2 running from the live session (nothing to back up yet).
set -e
[ "$(id -u)" -eq 0 ] || { echo "Run as root (use sudo)." >&2; exit 1; }

case "$(findmnt -no FSTYPE /)" in
  overlay|squashfs|aufs) exit 2 ;;
esac

SRC="$(findmnt -no SOURCE /)"
UUID="$(findmnt -no UUID / || true)"
[ -n "$UUID" ] || UUID="$(blkid -s UUID -o value "$SRC")"
[ -n "$UUID" ] || { echo "Could not find the system drive UUID." >&2; exit 1; }

mkdir -p /etc/timeshift /etc/harpreetlinux /var/lib/harpreetlinux
cat > /etc/timeshift/timeshift.json <<JSON
{
  "backup_device_uuid" : "$UUID",
  "parent_device_uuid" : "",
  "do_first_run" : "false",
  "btrfs_mode" : "false",
  "include_btrfs_home_for_backup" : "false",
  "include_btrfs_home_for_restore" : "false",
  "stop_cron_emails" : "true",
  "schedule_monthly" : "true",
  "schedule_weekly" : "true",
  "schedule_daily" : "false",
  "schedule_hourly" : "false",
  "schedule_boot" : "false",
  "count_monthly" : "2",
  "count_weekly" : "3",
  "count_daily" : "5",
  "count_hourly" : "6",
  "count_boot" : "5",
  "snapshot_size" : "0",
  "snapshot_count" : "0",
  "date_format" : "%Y-%m-%d %H:%M:%S"
}
JSON

# Timeshift's own package normally ships this cron job; create ours only if it is missing.
if [ ! -f /etc/cron.d/timeshift-hourly ]; then
  printf '0 * * * * root /usr/bin/timeshift --check --scripted\n' > /etc/cron.d/harpreetlinux-timeshift
fi

if [ "${1:-}" = "--apt-hook" ]; then
  touch /etc/harpreetlinux/snapshot-before-apt
else
  rm -f /etc/harpreetlinux/snapshot-before-apt
fi
touch /etc/harpreetlinux/backup-enabled
