#!/bin/sh
# Called by apt before packages change. Makes at most one snapshot a day, only if the user asked for it.
[ -f /etc/harpreetlinux/snapshot-before-apt ] || exit 0
[ -f /etc/harpreetlinux/backup-enabled ] || exit 0
command -v timeshift >/dev/null 2>&1 || exit 0
STAMP=/var/lib/harpreetlinux/last-apt-snapshot
if [ -f "$STAMP" ] && [ -n "$(find "$STAMP" -mmin -1440 2>/dev/null)" ]; then exit 0; fi
mkdir -p /var/lib/harpreetlinux
timeshift --create --comments "Before software changes" --tags O --scripted && touch "$STAMP"
exit 0
