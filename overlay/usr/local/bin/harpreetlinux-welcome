#!/bin/sh
# Shows a short welcome window at the first login. Run it again any time from the menu.
MARK="$HOME/.config/harpreetlinux/welcome-shown"
if [ "${1:-}" != "--force" ] && [ -f "$MARK" ]; then exit 0; fi
command -v zenity >/dev/null 2>&1 || exit 0
mkdir -p "$(dirname "$MARK")" && touch "$MARK"
. /usr/share/harpreetlinux/i18n.sh

out=$(zenity --question --width=460 --title="$HL_WELCOME_TITLE" \
  --window-icon=/usr/share/pixmaps/harpreetlinux-logo.png \
  --icon=/usr/share/pixmaps/harpreetlinux-logo.png \
  --text="$HL_WELCOME_TEXT" \
  --ok-label="$HL_WELCOME_OK" --cancel-label="$HL_WELCOME_CLOSE" \
  --extra-button="$HL_WELCOME_STORE" --extra-button="$HL_WELCOME_BACKUP")
rc=$?

if [ "$rc" -eq 0 ]; then
  exec x-terminal-emulator -e /usr/local/bin/harpreetlinux-setup
elif [ "$out" = "$HL_WELCOME_STORE" ]; then
  exec gnome-software
elif [ "$out" = "$HL_WELCOME_BACKUP" ]; then
  exec /usr/local/bin/harpreetlinux-backup
fi
