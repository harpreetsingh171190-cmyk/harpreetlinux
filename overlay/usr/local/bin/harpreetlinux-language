#!/bin/sh
# Switch the system language between English and Punjabi (applies after the next login).
command -v zenity >/dev/null 2>&1 || exit 0
. /usr/share/harpreetlinux/i18n.sh
choice=$(zenity --list --radiolist --title="$HL_LANG_TITLE" --text="$HL_LANG_TEXT" \
  --window-icon=/usr/share/pixmaps/harpreetlinux-logo.png \
  --column="" --column="code" --column="$HL_LANG_COL" --hide-column=2 --print-column=2 \
  --width=360 --height=260 \
  "$( [ "$HL_LANG" = en ] && echo TRUE || echo FALSE )" en "English" \
  "$( [ "$HL_LANG" = pa ] && echo TRUE || echo FALSE )" pa "ਪੰਜਾਬੀ (Punjabi)") || exit 0

if [ "$choice" = pa ]; then
  pkexec update-locale LANG=pa_IN.UTF-8 LANGUAGE=pa:en
else
  pkexec update-locale LANG=en_US.UTF-8 LANGUAGE
fi
if [ $? -eq 0 ]; then
  zenity --info --width=360 --title="$HL_LANG_TITLE" --text="$HL_LANG_DONE"
else
  zenity --error --width=360 --title="$HL_LANG_TITLE" --text="$HL_LANG_FAIL"
fi
