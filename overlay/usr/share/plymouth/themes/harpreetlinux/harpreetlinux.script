Window.SetBackgroundTopColor(0.06, 0.09, 0.16);
Window.SetBackgroundBottomColor(0.12, 0.11, 0.29);

logo = Image("logo.png");
sprite = Sprite(logo);
sprite.SetX(Window.GetWidth() / 2 - logo.GetWidth() / 2);
sprite.SetY(Window.GetHeight() / 2 - logo.GetHeight() / 2);

frame = 0;
fun refresh_callback() {
  frame++;
  sprite.SetOpacity(0.8 + 0.2 * Math.Sin(frame / 15));
}
Plymouth.SetRefreshFunction(refresh_callback);
